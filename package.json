{
  "name": "lyrics-scroller-mict",
  "version": "1.0.0",
  "private": true,
  "description": "Lyrics Scroller MICT",
  "main": "main.js",
  "author": "Lyrics Scroller MICT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lyricsscroller.mict",
    "productName": "Lyrics Scroller MICT",
    "artifactName": "Lyrics Scroller MICT Setup ${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "icon": "MICT-MICT.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyrics Scroller MICT",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}